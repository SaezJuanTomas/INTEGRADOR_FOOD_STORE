# =============================================================================
# CONFIGURACIÓN DEL FRONTEND
# =============================================================================
# Copiar como .env y completar con valores reales.
# NUNCA subir .env al repositorio.

# URL del backend (sin /api)
VITE_API_URL=http://localhost:8000

# Clave pública de MercadoPago.
# Se usa solo como flag para saber si MP está configurado.
# Misma que en backend/.env: MP_PUBLIC_KEY
VITE_MP_PUBLIC_KEY=TEST-tu-public-key-de-mercadopago
